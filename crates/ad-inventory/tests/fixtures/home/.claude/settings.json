{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "echo pre2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "plug@mkt": true,
    "offplug@mkt": false
  },
  "theme": "dark"
}
